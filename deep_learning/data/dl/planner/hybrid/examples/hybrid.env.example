# Copy to server-only config/hybrid.env. Fill actual values; do not commit keys.
# Existing LLM_API_URL / LLM_API_KEY / LLM_MODEL are also accepted.
HYBRID_LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
HYBRID_LLM_MODEL=
# Key may be blank only for a loopback provider such as local Ollama.
HYBRID_LLM_API_KEY=
# Cold GPU model startup may exceed the default 30-second socket timeout.
HYBRID_LLM_TIMEOUT_SECONDS=90
HYBRID_LLM_MAX_TOKENS=2048
# For the existing Ollama Qwen3 boolean-thinking model; omit for other providers.
HYBRID_LLM_REASONING_EFFORT=none
# Opt in only when the provider supports JSON Schema structured outputs.
# Runtime validators still check IDs, quotes, dependencies and scope.
HYBRID_LLM_RESPONSE_FORMAT=json_schema
HYBRID_SERVICE_API_KEY=
HYBRID_MODE=hybrid
HYBRID_BACKEND=v5
HYBRID_PORT=8103
# Optional reviewed-data-trained artifact directory; required for mode=ml.
HYBRID_MODEL_ARTIFACT=
